{
  "http": {
    "hostname": "127.0.0.1",
    "port": 4317,
    "publicOrigin": "https://host.tailnet.ts.net"
  },
  "auth": {
    "mode": "tailscale-serve",
    "allowedLogins": ["replace-with-your-tailnet-login@example.com"]
  },
  "registry": {
    "heartbeatSeconds": 10,
    "ttlSeconds": 35,
    "maxSessions": 100
  }
}
