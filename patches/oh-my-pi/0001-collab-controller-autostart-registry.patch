+			model: { provider: "openai", id: "gpt-5.4" },
+		});
+		await controller.refreshMetadata();
+
+		expect(published).toHaveLength(2);
+		expect(published[1]).toMatchObject({
+			instanceId: published[0]?.instanceId,
+			sessionId: published[0]?.sessionId,
