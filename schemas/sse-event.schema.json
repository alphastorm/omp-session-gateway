{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omp-session-gateway/sse-event.schema.json",
  "title": "OMP Session Gateway metadata-only SSE event",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision", "sessions"],
      "properties": {
        "type": { "const": "snapshot" },
        "revision": { "$ref": "session-list.schema.json#/properties/revision" },
        "sessions": { "$ref": "session-list.schema.json#/properties/sessions" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision", "session"],
      "properties": {
        "type": { "const": "session_upsert" },
        "revision": { "$ref": "session-list.schema.json#/properties/revision" },
        "session": { "$ref": "session-list.schema.json#/properties/sessions/items" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "revision", "instanceId", "generation"],
      "properties": {
        "type": { "const": "session_remove" },
        "revision": { "$ref": "session-list.schema.json#/properties/revision" },
        "instanceId": { "$ref": "session-list.schema.json#/properties/sessions/items/properties/instanceId" },
        "generation": { "$ref": "session-list.schema.json#/properties/sessions/items/properties/generation" }
      }
    }
  ]
}
