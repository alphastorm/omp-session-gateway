{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alphastorm/omp-session-gateway/schemas/stable-release.schema.json",
  "title": "OMP Session Gateway stable release qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "version",
    "releaseTag",
    "previousTag",
    "status",
    "candidateTag",
    "candidateSourceCommit",
    "candidateArchiveSha256",
    "runtimeByteComparison",
    "evidence",
    "approvedAt"
  ],
  "properties": {
    "$schema": { "const": "./schemas/stable-release.schema.json" },
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "releaseTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "previousTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["pending", "qualified"] },
    "candidateTag": { "type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-prealpha\\.[1-9][0-9]*$" },
    "candidateSourceCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "candidateArchiveSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "runtimeByteComparison": { "enum": ["pending", "passed"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "From 0.6.0, release-policy.ts also requires windows and androidPush (ADR-031); from 0.6.2, deviceCloud (ADR-032).",
      "required": ["debian", "macos", "android", "ompPublication", "provenance", "secretSinks"],
      "properties": {
        "debian": { "enum": ["pending", "passed"] },
        "macos": { "enum": ["pending", "passed"] },
        "android": { "enum": ["pending", "passed"] },
        "androidPush": { "enum": ["pending", "passed"] },
        "ompPublication": { "enum": ["pending", "passed"] },
        "deviceCloud": { "enum": ["pending", "passed"] },
        "provenance": { "enum": ["pending", "passed"] },
        "secretSinks": { "enum": ["pending", "passed"] },
        "windows": { "enum": ["pending", "passed"] }
      }
    },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
